{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "System Design Simulator — Architecture Library API",
    "version": "1.0.0-draft",
    "description": "Release 1 milestone 1 design contract. Architecture CRUD and explicit Save only; simulation is deferred. POST is first Save and PUT replaces an existing saved document. The frontend owns unsaved edits. x-strict-integer and x-finite describe required runtime checks beyond standard JSON Schema."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Example local development address; configurable during implementation."
    }
  ],
  "tags": [
    {
      "name": "Architectures",
      "description": "Local SQLite architecture library and explicit Save."
    }
  ],
  "paths": {
    "/api/v1/architectures": {
      "post": {
        "tags": [
          "Architectures"
        ],
        "operationId": "createArchitecture",
        "summary": "Create and save an architecture",
        "description": "First Save creates a new persisted architecture. Accepts incomplete diagrams. Every successful POST creates a new ID; retries are not idempotent.",
        "requestBody": {
          "$ref": "#/components/requestBodies/ArchitectureWrite"
        },
        "responses": {
          "201": {
            "description": "Architecture durably created. Creation and update timestamps are equal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Architecture"
                },
                "example": {
                  "id": "0ccdc365-31f4-46c8-9f94-2b36d7f73b08",
                  "name": "Application with database",
                  "created_at": "2026-10-03T15:00:00.000000Z",
                  "updated_at": "2026-10-03T15:00:00.000000Z",
                  "document": {
                    "format_version": 1,
                    "nodes": [
                      {
                        "id": "callers",
                        "type": "caller_group",
                        "label": "Callers",
                        "position": {
                          "x": -80,
                          "y": 120.5
                        },
                        "capacity_rps": null,
                        "caller_count": 100,
                        "test_rps": 100
                      },
                      {
                        "id": "lb",
                        "type": "load_balancer",
                        "label": "Load balancer",
                        "position": {
                          "x": 160,
                          "y": 120.5
                        },
                        "capacity_rps": 100,
                        "routing_policy": "weighted"
                      },
                      {
                        "id": "gateway",
                        "type": "gateway",
                        "label": "Gateway",
                        "position": {
                          "x": 400,
                          "y": 120.5
                        },
                        "capacity_rps": 100,
                        "routing_policy": "round_robin"
                      },
                      {
                        "id": "server",
                        "type": "server",
                        "label": "Server",
                        "position": {
                          "x": 640,
                          "y": 120.5
                        },
                        "capacity_rps": 60
                      },
                      {
                        "id": "database",
                        "type": "database",
                        "label": "Database",
                        "position": {
                          "x": 880,
                          "y": 120.5
                        },
                        "capacity_rps": 60
                      }
                    ],
                    "edges": [
                      {
                        "id": "callers-lb",
                        "source": "callers",
                        "target": "lb",
                        "order": 0,
                        "weight": 1
                      },
                      {
                        "id": "lb-gateway",
                        "source": "lb",
                        "target": "gateway",
                        "order": 0,
                        "weight": 1.5
                      },
                      {
                        "id": "gateway-server",
                        "source": "gateway",
                        "target": "server",
                        "order": 0,
                        "weight": 0
                      },
                      {
                        "id": "server-database",
                        "source": "server",
                        "target": "database",
                        "order": 0,
                        "weight": 1
                      }
                    ]
                  }
                }
              }
            },
            "headers": {
              "Location": {
                "required": true,
                "description": "Relative route for the newly saved architecture.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                },
                "example": "/api/v1/architectures/0ccdc365-31f4-46c8-9f94-2b36d7f73b08"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidJson"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "503": {
            "$ref": "#/components/responses/StorageUnavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "get": {
        "tags": [
          "Architectures"
        ],
        "operationId": "listArchitectures",
        "summary": "List saved architectures",
        "description": "Metadata only. All entries, ordered by updated_at descending then ID ascending. No pagination. An empty library returns items: [].",
        "responses": {
          "200": {
            "description": "Saved architecture metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchitectureList"
                },
                "examples": {
                  "library": {
                    "value": {
                      "items": [
                        {
                          "id": "0ccdc365-31f4-46c8-9f94-2b36d7f73b08",
                          "name": "Application with database",
                          "created_at": "2026-10-03T15:00:00.000000Z",
                          "updated_at": "2026-10-03T15:00:00.000000Z",
                          "format_version": 1
                        }
                      ]
                    }
                  },
                  "empty": {
                    "value": {
                      "items": []
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/StorageUnavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/architectures/{architecture_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ArchitectureId"
        }
      ],
      "get": {
        "tags": [
          "Architectures"
        ],
        "operationId": "getArchitecture",
        "summary": "Open a saved architecture",
        "description": "Return the latest saved document. Unknown well-formed UUIDs return 404; invalid UUID strings return 422.",
        "responses": {
          "200": {
            "description": "Complete latest saved architecture.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Architecture"
                },
                "example": {
                  "id": "0ccdc365-31f4-46c8-9f94-2b36d7f73b08",
                  "name": "Application with database",
                  "created_at": "2026-10-03T15:00:00.000000Z",
                  "updated_at": "2026-10-03T15:00:00.000000Z",
                  "document": {
                    "format_version": 1,
                    "nodes": [
                      {
