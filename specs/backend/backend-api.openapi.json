      "delete": {
        "tags": [
          "Architectures"
        ],
        "operationId": "deleteArchitecture",
        "summary": "Delete a saved architecture",
        "description": "Atomically delete the architecture. Success has no body. Subsequent reads, writes, and deletes return 404.",
        "responses": {
          "204": {
            "description": "Architecture deleted. No response body."
          },
          "404": {
            "$ref": "#/components/responses/ArchitectureNotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
