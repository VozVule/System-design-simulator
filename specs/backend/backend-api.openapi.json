                        "label": "Gateway",
                        "position": {
                          "x": 400,
                          "y": 120.5
                        },
                        "capacity_rps": 100,
                        "routing_policy": "round_robin"
                      },
                      {
                        "id": "server",
                        "type": "server",
                        "label": "Server",
                        "position": {
                          "x": 640,
                          "y": 120.5
                        },
                        "capacity_rps": 60
                      },
                      {
                        "id": "database",
