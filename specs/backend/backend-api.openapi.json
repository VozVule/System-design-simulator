                        },
                        "capacity_rps": 60
                      }
                    ],
                    "edges": [
                      {
                        "id": "callers-lb",
                        "source": "callers",
                        "target": "lb",
                        "order": 0,
                        "weight": 1
                      },
                      {
                        "id": "lb-gateway",
                        "source": "lb",
                        "target": "gateway",
                        "order": 0,
                        "weight": 1.5
                      },
                      {
                        "id": "gateway-server",
                        "source": "gateway",
                        "target": "server",
                        "order": 0,
                        "weight": 0
                      },
                      {
                        "id": "server-database",
                        "source": "server",
                        "target": "database",
                        "order": 0,
                        "weight": 1
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ArchitectureNotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "503": {
            "$ref": "#/components/responses/StorageUnavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "tags": [
          "Architectures"
        ],
        "operationId": "replaceArchitecture",
        "summary": "Save a complete replacement architecture",
        "description": "Atomically replace name and entire document; no merging or upsert. Remove omitted elements and retain ID/created_at. Advance updated_at only when validated content changes. An identical PUT preserves timestamps. Incident edges must be removed with a deleted node. Unknown UUIDs return 404.",
        "requestBody": {
          "$ref": "#/components/requestBodies/ArchitectureWrite"
        },
        "responses": {
          "200": {
            "description": "Complete authoritative saved representation after commit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Architecture"
                },
                "example": {
                  "id": "0ccdc365-31f4-46c8-9f94-2b36d7f73b08",
                  "name": "Renamed application",
                  "created_at": "2026-10-03T15:00:00.000000Z",
                  "updated_at": "2026-10-03T15:01:00.000000Z",
                  "document": {
                    "format_version": 1,
                    "nodes": [
                      {
                        "id": "callers",
                        "type": "caller_group",
                        "label": "Callers",
                        "position": {
                          "x": -80,
