{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "allowJs": false, "resolveJsonModule": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "esModuleInterop": true, "skipLibCheck": true,
    "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"]
}
