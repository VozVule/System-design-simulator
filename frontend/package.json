{
  "name": "sysd-simulator-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "npm run check && npm test && npm run test:browser && npm run build"
  },
  "dependencies": {
    "@lucide/svelte": "1.51.0",
    "@xyflow/svelte": "1.7.0",
    "svelte": "5.57.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
